{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/play(.*)", "destination": "/monomap/web/play.html$1" },
    { "source": "/compare(.*)", "destination": "/monomap/web/compare.html$1" },
    { "source": "/download(.*)", "destination": "/monomap/web/download.html$1" },
    { "source": "/web/(.*)", "destination": "/monomap/web/$1" },
    { "source": "/output/(.*)", "destination": "/monomap/output/$1" }
  ]
}
