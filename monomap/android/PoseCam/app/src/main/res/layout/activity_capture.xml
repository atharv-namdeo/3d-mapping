<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- AR Camera Live View -->
    <android.opengl.GLSurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top App & Menu Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#D0090D16"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PoseCam 3D"
                android:textColor="@color/text_white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Metric ARCore + IMU"
                android:textColor="@color/accent_blue"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/menu_guide"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_secondary"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="ℹ️ Guide"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/menu_settings"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_secondary"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="⚙️ Mode"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/sessions"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/button_primary"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="📁 Files"
            android:textAllCaps="false"
            android:textColor="#0B0F19"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Floating Tracking & Gravity Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/pill_bg"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="⏳ Initializing ARCore camera..."
            android:textColor="@color/text_white"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Controls Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D9090D16"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Storage & Folder Path Banner -->
        <TextView
            android:id="@+id/tv_storage_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="📁 Storage: Android/data/com.posecam/files/captures"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp" />

        <!-- Record Button -->
        <Button
            android:id="@+id/record"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_record"
            android:enabled="false"
            android:text="@string/record"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Hidden or secondary buttons maintained for ID compatibility -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/resolution"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_secondary"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textAllCaps="false"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/focus"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/button_secondary"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textAllCaps="false"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
